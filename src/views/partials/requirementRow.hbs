<tr>
  <td>{{category}}</td>
  <td>{{material}}</td>
  <td>
    <input class="form-control form-control-sm" type="number" name="quantity" value="{{required_quantity}}" min="0.01" step="0.01"
           hx-post="/projects/{{project_id}}/requirements/{{id}}" hx-trigger="change" hx-target="closest tr" hx-swap="outerHTML">
  </td>
  <td>{{unit}}</td>
  <td class="text-end">
    <button class="btn btn-sm btn-outline-danger" hx-delete="/projects/{{project_id}}/requirements/{{id}}"
            hx-target="closest tr" hx-swap="outerHTML" hx-confirm="Remove this material?">Delete</button>
  </td>
</tr>
