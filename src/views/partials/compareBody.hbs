{{#if error}}<div class="alert alert-danger">{{error}}</div>{{/if}}
{{#each sections}}
<h2 class="h5 mt-4">{{requirement.material}} <small class="text-muted">{{requirement.required_quantity}} {{requirement.unit}}</small></h2>
{{#if offers.length}}
<table class="table table-sm align-middle">
  <thead>
    <tr><th>#</th><th>Supplier</th><th>Rating</th><th>Distance (km)</th><th>Material</th><th>Delivery</th><th>Tax</th><th>Total</th><th></th></tr>
  </thead>
  <tbody>
    {{#each offers}}
    <tr>
      <td>{{position}}</td>
      <td>{{name}}<div class="small text-muted">{{money unitPrice}} per {{../requirement.unit}}</div></td>
      <td>{{stars avgScore}}{{#if ratingCnt}} <span class="small text-muted">({{ratingCnt}})</span>{{/if}}</td>
      <td>
        <form class="d-flex gap-1" hx-post="/projects/{{@root.project.id}}/distances" hx-target="#compare" hx-swap="innerHTML">
          <input type="hidden" name="supplier_id" value="{{supplierId}}">
          <input type="hidden" name="sort" value="{{@root.sort}}">
          <input class="form-control form-control-sm" style="width: 90px" type="number" name="distance_km" value="{{distanceKm}}" min="0" step="0.1">
          <button class="btn btn-sm btn-outline-secondary">Set</button>
        </form>
      </td>
      <td>{{money costs.material}}</td>
      <td>{{money costs.delivery}}</td>
      <td>{{money costs.tax}}</td>
      <td class="fw-bold">{{money costs.total}}</td>
      <td>
        <form action="/projects/{{@root.project.id}}/orders" method="POST" hx-boost="false">
          <input type="hidden" name="catalog_id" value="{{catalogId}}">
          <button class="btn btn-sm btn-success">Order</button>
        </form>
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>
{{else}}
<p class="text-muted">No active supplier has enough capacity for this material.</p>
{{/if}}
{{else}}
<p class="text-muted">Add material requirements to the project first.</p>
{{/each}}
