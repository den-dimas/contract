{{> flash}}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Projects</h1>
  <a class="btn btn-primary" href="/projects/new">New project</a>
</div>
{{#if projects.length}}
<table class="table table-hover align-middle">
  <thead><tr><th>Name</th><th>Location</th><th>Tax</th><th>Materials</th><th>Orders</th></tr></thead>
  <tbody>
    {{#each projects}}
    <tr>
      <td><a href="/projects/{{id}}">{{name}}</a></td>
      <td>{{location}}</td>
      <td>{{percent tax_rate}}</td>
      <td>{{requirement_cnt}}</td>
      <td>{{order_cnt}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>
{{else}}
<p class="text-muted">No projects yet. Create your first project to start sourcing.</p>
{{/if}}
