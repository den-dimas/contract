{{> flash}}
<h1 class="h3">{{title}}</h1>
{{#if error}}<div class="alert alert-danger">{{error}}</div>{{/if}}
<form action="{{action}}" method="POST" class="col-md-6">
  <div class="mb-3"><label class="form-label">Name</label><input class="form-control" name="name" value="{{form.name}}" maxlength="120" required></div>
  <div class="mb-3"><label class="form-label">Location</label><input class="form-control" name="location" value="{{form.location}}" maxlength="160" required></div>
  <div class="mb-3"><label class="form-label">Tax rate (percent)</label><input class="form-control" type="number" name="tax_percent" value="{{form.tax_percent}}" min="0" max="100" step="0.01" required></div>
  <button class="btn btn-primary">Save</button>
  <a class="btn btn-link" href="{{#if isEdit}}/projects/{{projectId}}{{else}}/projects{{/if}}">Cancel</a>
</form>
