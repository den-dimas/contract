{{> flash}}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Suppliers</h1>
  <div class="d-flex gap-2">
    <a class="btn btn-outline-primary" href="/suppliers/import">Import spreadsheet</a>
    <a class="btn btn-primary" href="/suppliers/new">New supplier</a>
  </div>
</div>
<form method="GET" action="/suppliers" class="row g-2 mb-3">
  <div class="col-md-4"><input class="form-control" type="search" name="q" value="{{q}}" placeholder="Search by name"></div>
  <div class="col-md-3">
    <select class="form-select" name="status">
      <option value="active" {{#if (eq status 'active')}}selected{{/if}}>Active</option>
      <option value="inactive" {{#if (eq status 'inactive')}}selected{{/if}}>Inactive</option>
      <option value="all" {{#if (eq status 'all')}}selected{{/if}}>All</option>
    </select>
  </div>
  <div class="col-md-3">
    <select class="form-select" name="material">
      <option value="">Any material</option>
      {{#each materials}}<option value="{{id}}" {{#if isSelected}}selected{{/if}}>{{standard_name}}</option>{{/each}}
    </select>
  </div>
  <div class="col-md-2"><button class="btn btn-outline-secondary w-100">Filter</button></div>
</form>
{{#if suppliers.length}}
<table class="table align-middle">
  <thead><tr><th>Company</th><th>License</th><th>Materials</th><th>Status</th><th></th></tr></thead>
  <tbody>{{#each suppliers}}{{> supplierRow}}{{/each}}</tbody>
</table>
{{else}}
<p class="text-muted">No suppliers match. Add one or import a spreadsheet.</p>
{{/if}}
