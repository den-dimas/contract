
{{> flash}}

<h1 class="h3">{{#if isEdit}}Edit supplier{{else}}New supplier{{/if}}</h1>

{{#if error}}
  <div class="alert alert-danger">{{error}}</div>
{{/if}}

<form action="{{action}}" method="POST" class="col-md-8">

  <h2 class="h5 mb-3">Company Information</h2>

  <div class="mb-3">
    <label class="form-label">Company name *</label>
    <input
      class="form-control"
      name="companyName"
      value="{{form.company_name}}"
      maxlength="120"
      required>
  </div>

  <div class="mb-3">
    <label class="form-label">Trade name</label>
    <input
      class="form-control"
      name="tradeName"
      value="{{form.trade_name}}"
      maxlength="120">
  </div>

  <div class="mb-3">
    <label class="form-label">License number</label>
    <input
      class="form-control"
      name="licenseNo"
      value="{{form.license_no}}"
      maxlength="40">
  </div>

  <hr>

  <h2 class="h5 mb-3">Contact Information</h2>

  <div class="mb-3">
    <label class="form-label">Phone</label>
    <input
      class="form-control"
      type="tel"
      name="phone"
      value="{{form.phone}}"
      maxlength="40">
  </div>

  <div class="mb-3">
    <label class="form-label">Email</label>
    <input
      class="form-control"
      type="email"
      name="email"
      value="{{form.email}}"
      maxlength="160">
  </div>

  <div class="mb-3">
    <label class="form-label">Address</label>
    <input
      class="form-control"
      name="address"
      value="{{form.address}}"
      maxlength="200">
  </div>

  <hr>

  <h2 class="h5 mb-3">Additional Information</h2>

  <div class="mb-3">
    <label class="form-label">Company description</label>
    <textarea
      class="form-control"
      name="description"
      rows="3"
      maxlength="200">{{form.description}}</textarea>
  </div>

  <button type="submit" class="btn btn-primary">Save</button>
  <a class="btn btn-outline-secondary" href="/suppliers">Cancel</a>

</form>
