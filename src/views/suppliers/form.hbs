{{> flash}}
<h1 class="h3">{{#if isEdit}}Edit supplier{{else}}New supplier{{/if}}</h1>
{{#if error}}<div class="alert alert-danger">{{error}}</div>{{/if}}
<form action="{{action}}" method="POST" class="col-md-6">
  <div class="mb-3"><label class="form-label">Company name</label><input class="form-control" name="companyName" value="{{form.company_name}}" maxlength="120" required></div>
  <div class="mb-3"><label class="form-label">License number</label><input class="form-control" name="licenseNo" value="{{form.license_no}}" maxlength="40"></div>
  <button class="btn btn-primary">Save</button>
  <a class="btn btn-link" href="/suppliers">Cancel</a>
</form>
